    {
      "id": 22,
      "type": "bargauge",
      "title": "Hours since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "facetrack-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "facetrack-prometheus"
          },
          "expr": "(time() - facetrack_backend_day_close_last_success_timestamp) / 3600",
          "legendFormat": "day close"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "facetrack-prometheus"
          },
          "expr": "(time() - facetrack_backend_payroll_push_last_success_timestamp) / 3600",
          "legendFormat": "payroll push"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "facetrack-prometheus"
          },
          "expr": "(time() - facetrack_backend_hr_sync_last_success_timestamp) / 3600",
          "legendFormat": "HR sync"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "facetrack-prometheus"
          },
          "expr": "(time() - facetrack_backup_last_success_timestamp_seconds) / 3600",
          "legendFormat": "backup"
        }
