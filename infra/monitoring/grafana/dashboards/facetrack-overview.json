    {
      "id": 2,
      "type": "stat",
      "title": "Cameras offline",
      "datasource": {
        "type": "prometheus",
        "uid": "facetrack-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "facetrack-prometheus"
          },
          "expr": "sum(facetrack_engine_camera_connected == bool 0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
