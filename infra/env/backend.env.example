# Backend, worker and scheduler (see backend/app/core/config.py). Copy to backend.env; never commit it.
# DATABASE_URL, REDIS_URL, MEDIAMTX_API_URL and MEDIA_ROOT are set by docker-compose.yml.
ENVIRONMENT=production
LOG_LEVEL=INFO
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Same base64 AES-256 key as ENGINE_ENCRYPTION_KEY on every engine node
ENCRYPTION_KEY=change-me
COOKIE_SECURE=true
CORS_ORIGINS=["https://facetrack.example.local"]
PORTAL_BASE_URL=https://facetrack.example.local
API_DOCS_ENABLED=false

# Engine nodes reachable from the backend host (VLAN addresses), and their shared token
ENGINE_NODES={"node-1": "http://10.20.0.11:8100"}
ENGINE_API_TOKEN=change-me
EMBEDDER_MODEL=sface

STORAGE_BACKEND=local
MEDIAMTX_WEBRTC_PUBLIC_PATH=/webrtc

# Integrations (optional)
PAYROLL_WEBHOOK_SECRET=
HR_API_TOKEN=
API_KEY_RATE_LIMIT_PER_MINUTE=120
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=facetrack@example.local
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=

# The first Super Admin is created once with `docker compose run --rm -e SEED_ADMIN_...` (docs/runbook.md);
# do not keep that password in this file.
