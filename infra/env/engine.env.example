# One engine node (see engine/app/config.py). Copy to engine.env; never commit it.
ENGINE_ENVIRONMENT=production
ENGINE_NODE_NAME=node-1
ENGINE_LOG_LEVEL=INFO
ENGINE_API_TOKEN=change-me
# Read-only role created by infra/postgres/init (password = ENGINE_DB_PASSWORD in infra/.env)
ENGINE_DATABASE_URL=postgresql+asyncpg://facetrack_engine:change-me@10.20.0.10:5432/facetrack
ENGINE_REDIS_URL=redis://:change-me@10.20.0.10:6379/0
ENGINE_ENCRYPTION_KEY=change-me
ENGINE_STORAGE_BACKEND=local
ENGINE_RUNTIME=openvino
ENGINE_OPENVINO_PRECISION=f32
ENGINE_EMBEDDER=sface
ENGINE_INFERENCE_WORKERS=4
ENGINE_THREADS_PER_WORKER=3
ENGINE_INFERENCE_CORES=
ENGINE_MAX_CAMERAS=32
ENGINE_ALLOW_FILE_SOURCES=false
# Camera that refuses the login (RTSP 401/403): next attempt after this many seconds (Q61; min 60).
ENGINE_AUTH_RETRY_S=900
