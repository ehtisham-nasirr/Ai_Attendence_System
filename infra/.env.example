# Docker Compose variables for infra/ (copy to infra/.env; never commit it).
REGISTRY=facetrack
FACETRACK_VERSION=latest
SERVER_NAME=facetrack.example.local
TZ=Asia/Karachi

# Bind addresses: PUBLIC = what users reach (Nginx, WebRTC media); INTERNAL = the isolated VLAN
# address engine nodes use for PostgreSQL/Redis and Prometheus uses for engine metrics (§19).
PUBLIC_BIND_IP=0.0.0.0
INTERNAL_BIND_IP=127.0.0.1
MEDIAMTX_PUBLIC_HOST=10.20.0.10

# Secrets (generate each: openssl rand -hex 32). Use hex: the database and Redis passwords go into
# connection URLs, where a '/' (common in base64) breaks the Redis URL.
POSTGRES_PASSWORD=change-me
ENGINE_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
BACKUP_ENCRYPTION_KEY=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Paths on the host (owned by uid 10001 for media). On multi-server setups MEDIA_DIR is an NFS mount.
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=30

WEB_CONCURRENCY=2
WORKER_CONCURRENCY=4
PROMETHEUS_RETENTION=30d

# Alert delivery (§18: email and Microsoft Teams)
ALERT_EMAIL_TO=it-ops@example.local
SMTP_SMARTHOST=smtp.example.local:587
SMTP_FROM=facetrack@example.local
SMTP_USERNAME=
SMTP_PASSWORD=
TEAMS_WEBHOOK_URL=

# Engine node (docker-compose.engine.yml)
ENGINE_CPUSET=0-15
ENGINE_CPUS=14
ENGINE_MEMORY=12g

# Laptop/test machine only (docker-compose.dev.yml, docs/local-development.md). Uncomment COMPOSE_FILE so
# every docker compose command in infra/ includes the dev engine. Its CPU/memory caps (defaults 2 / 3g):
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# ENGINE_DEV_CPUS=2
# ENGINE_DEV_MEMORY=3g
