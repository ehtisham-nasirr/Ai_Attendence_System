# FaceTrack engine configuration (copy to .env; never commit .env). See app/config.py.
ENGINE_ENVIRONMENT=development
ENGINE_NODE_NAME=node-1
ENGINE_LOG_LEVEL=INFO

# Shared secret the backend sends as X-Engine-Token (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
ENGINE_API_TOKEN=change-me
ENGINE_DATABASE_URL=postgresql+asyncpg://facetrack:change-me@postgres:5432/facetrack
ENGINE_REDIS_URL=redis://redis:6379/0
# Base64 AES-256 key, identical to the backend's ENCRYPTION_KEY
# (generate: python -c "from facetrack_common.crypto import generate_key_b64;print(generate_key_b64())")
ENGINE_ENCRYPTION_KEY=change-me

# Object storage (ADR-0005): local = volume shared with the backend; s3 = any S3-compatible server
ENGINE_STORAGE_BACKEND=local
ENGINE_MEDIA_ROOT=/srv/media
# ENGINE_S3_ENDPOINT=s3.internal:9000
# ENGINE_S3_ACCESS_KEY=change-me
# ENGINE_S3_SECRET_KEY=change-me
# ENGINE_S3_SECURE=true
# ENGINE_S3_BUCKET=facetrack

# Models (downloaded by scripts/download_models.py; never committed)
ENGINE_RUNTIME=openvino
ENGINE_OPENVINO_PRECISION=f32
ENGINE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
ENGINE_EMBEDDER=sface
ENGINE_EMBEDDER_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
# ENGINE_LIVENESS_MODEL_PATH=models/minifasnet_v2.onnx

# CPU budget: workers x threads must not exceed the cores reserved for the engine
ENGINE_INFERENCE_WORKERS=2
ENGINE_THREADS_PER_WORKER=2
ENGINE_INFERENCE_CORES=
ENGINE_MAX_CAMERAS=32

ENGINE_BUFFER_DIR=buffer
# Development only: allow file:// camera URLs (looped sample clips)
ENGINE_ALLOW_FILE_SOURCES=false
