# FaceTrack backend configuration (copy to .env; never commit .env). See app/core/config.py.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://facetrack:change-me@postgres:5432/facetrack
REDIS_URL=redis://redis:6379/0
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Same base64 AES-256 key as the engine's ENGINE_ENCRYPTION_KEY
ENCRYPTION_KEY=change-me
COOKIE_SECURE=true
CORS_ORIGINS=["https://facetrack.example.local"]
PORTAL_BASE_URL=https://facetrack.example.local
API_DOCS_ENABLED=true

ENGINE_NODES={"node-1": "http://engine:8100"}
ENGINE_API_TOKEN=change-me
EMBEDDER_MODEL=sface

STORAGE_BACKEND=local
MEDIA_ROOT=/srv/media
# S3_ENDPOINT=s3.internal:9000
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me

MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_WEBRTC_PUBLIC_PATH=/webrtc

# Integrations (optional; URLs and schedules are in Settings > Integration)
# HMAC key shared with the payroll system for the signed webhook (FR-35)
PAYROLL_WEBHOOK_SECRET=
# Bearer token FaceTrack sends to the HR system API (FR-12)
HR_API_TOKEN=
API_KEY_RATE_LIMIT_PER_MINUTE=120
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=facetrack@example.local
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=

# Only for `python -m app.scripts.seed` (first Super Admin)
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
